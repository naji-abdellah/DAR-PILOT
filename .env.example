# Environment Variables Example for DarPilot
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

# App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Backend Security
# Used to sign JWTs. Generate a strong random value, never commit it.
DARPILOT_SECRET_KEY=change_this_to_a_random_secret_key_in_production

# CORS - comma-separated list of allowed origins (locked down by default)
DARPILOT_CORS_ORIGINS=

# Database
DATABASE_URL=sqlite:///./darpilot.db
# Override DB path for tests (throwaway database, test isolation)
DARPILOT_DB_PATH=/tmp/darpilot_test.db

# LLM API Keys (Free Tiers)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
